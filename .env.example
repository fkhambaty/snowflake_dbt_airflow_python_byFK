# ---- Postgres (source OLTP) ----
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=meridian_core
PG_USER=meridian
PG_PASSWORD=meridian

# ---- Snowflake (target) ----
SNOWFLAKE_ACCOUNT=xy12345.ap-south-1          # <org>-<account> or <locator>.<region>
SNOWFLAKE_USER=MERIDIAN_LOADER_SVC
# Prefer key-pair auth (03_snowflake/01_account_setup_rbac.sql shows how to register the public key)
SNOWFLAKE_PRIVATE_KEY_PATH=~/.ssh/meridian_rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Fallback for quick demos only (MFA-enforced accounts will reject plain passwords for humans)
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=MERIDIAN_LOADER
SNOWFLAKE_WAREHOUSE=WH_INGEST_XS
SNOWFLAKE_RAW_DATABASE=MERIDIAN_RAW
# dbt dev/reconciliation and model training sign in as their own service users.
# Without these they fall back to SNOWFLAKE_USER (the loader), which lacks their roles.
SNOWFLAKE_DBT_USER=MERIDIAN_DBT_SVC
SNOWFLAKE_ML_USER=MERIDIAN_ML_SVC

# ---- Ingestion behaviour ----
INGEST_LAG_SECONDS=10          # safety lag so in-flight Postgres commits are not skipped
INGEST_CHUNK_ROWS=200000       # rows per Parquet file
INGEST_LOCAL_DIR=/tmp/meridian_ingest

# ---- Alerts ----
# Slack incoming-webhook URL (Slack app -> Incoming Webhooks). Empty = failures are only logged.
# The URL is a credential: keep it in .env, never in git.
MERIDIAN_SLACK_WEBHOOK_URL=
