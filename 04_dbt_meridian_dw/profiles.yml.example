# Copy to ~/.dbt/profiles.yml (or keep here and run `dbt --profiles-dir .`)
# Two targets: dev builds into DBT_<USER>_* schemas, prod into STAGING/INTERMEDIATE/MARTS.
meridian_dw:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_DBT_USER', env_var('SNOWFLAKE_USER')) }}"
      # key-pair auth (recommended). For a quick demo you can swap for password + authenticator.
      private_key_path: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PATH') }}"
      private_key_passphrase: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PASSPHRASE', '') }}"
      role: MERIDIAN_TRANSFORMER
      warehouse: WH_TRANSFORM_XS
      database: MERIDIAN_ANALYTICS
      schema: "{{ env_var('DBT_SCHEMA', 'dbt_fk') }}"   # dev prefix: dbt_fk_staging, dbt_fk_marts ... (CI overrides per PR)
      threads: 8
      client_session_keep_alive: false
      query_tag: dbt_dev
    dev_clone:
      # Created by 03_snowflake/09_zero_copy_dev_environment.sql and dropped after use.
      # Unlike --defer, untouched upstreams are a consistent snapshot of production.
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_DBT_USER', env_var('SNOWFLAKE_USER')) }}"
      private_key_path: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PATH') }}"
      private_key_passphrase: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PASSPHRASE', '') }}"
      role: MERIDIAN_TRANSFORMER
      warehouse: WH_TRANSFORM_XS
      database: "{{ env_var('DBT_CLONE_DATABASE') }}"
      schema: analytics
      threads: 8
      client_session_keep_alive: false
      query_tag: dbt_dev_clone
    prod:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: MERIDIAN_DBT_SVC
      private_key_path: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PATH') }}"
      private_key_passphrase: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PASSPHRASE', '') }}"
      role: MERIDIAN_TRANSFORMER
      warehouse: WH_TRANSFORM_XS
      database: MERIDIAN_ANALYTICS
      schema: analytics              # ignored for custom-schema models, see generate_schema_name
      threads: 12
      query_tag: dbt_prod
